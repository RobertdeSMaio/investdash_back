# Copie para .env (local) ou cadastre em Vercel > Settings > Environment Variables.
# Nunca versione o .env com valores reais.

# Neon PostgreSQL
DATABASE_URL=postgresql://usuario:senha@host/db?sslmode=require

# Segredos JWT — use valores longos e diferentes entre si, ex.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# SMTP (ex.: Resend)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM="InvestDash" <onboarding@resend.dev>

# Token da brapi.dev (https://brapi.dev/dashboard). Sem ele, só os tickers de
# teste (PETR4, VALE3, MGLU3, ITUB4) têm cotação.
BRAPI_TOKEN=

# URL do frontend: usada nos links de confirmação de e-mail e reset de senha
APP_URL=https://investdash.vercel.app

# Origem liberada no CORS (o domínio do frontend, sem barra no final).
# Lida no build (next.config.ts): ao alterar, faça um novo deploy.
ALLOWED_ORIGIN=https://investdash.vercel.app
